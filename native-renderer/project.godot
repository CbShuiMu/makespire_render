config_version=5

[application]
config/name="SpireFactoryNativeRenderer"
run/main_scene="res://render.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SpireFactoryNativeRenderer"

[display]
window/size/viewport_width=16
window/size/viewport_height=16
window/vsync/vsync_mode=0
window/size/borderless=true

[dotnet]
project/assembly_name="NativeRenderer"

[gui]
common/snap_controls_to_pixels=false
fonts/dynamic_fonts/use_oversampling=false

[rendering]
renderer/rendering_method="mobile"
rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
